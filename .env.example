# Scegliere una password lunga e unica prima dell'avvio.
NVR_ADMIN_PASSWORD=
# IP privato della macchina per accesso LAN; 127.0.0.1 limita al PC locale.
NVR_BIND_IP=127.0.0.1
NVR_RECORDINGS_PATH=./recordings
NVR_SEGMENT_SECONDS=60
NVR_MIN_FREE_GB=5
# Impostare 1 solo dietro HTTPS locale.
NVR_SECURE_COOKIE=0
